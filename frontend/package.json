{
  "name": "fitproplayer-frontend",
  "private": true,
  "version": "1.2.9",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8080 --strictPort",
    "build": "npm run generate:licenses && vite build",
    "build:vercel": "npm run generate:licenses && vite build --mode vercel",
    "build:mobile": "npm run generate:licenses && vite build --mode mobile && cap sync",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fatigue-probe": "node scripts/fatigue-monotonic-probe.mjs",
    "generate:motions": "node scripts/generate-posecode-library.mjs",
    "generate:licenses": "node scripts/generate-third-party-licenses.mjs",
    "check:i18n": "node scripts/check-locales.mjs && node scripts/check-source-strings.mjs --strict && node scripts/check-pt-br.mjs"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "posecode-parser": "0.4.2",
    "posecode-render": "0.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "three": "0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/ios": "^7.6.8",
    "@vitejs/plugin-react": "^6.0.3",
    "happy-dom": "^20.11.2",
    "linkedom": "^0.18.13",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
