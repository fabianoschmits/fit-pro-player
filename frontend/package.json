{
  "name": "fitproplayer-frontend",
  "private": true,
  "version": "1.2.9",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8080 --strictPort",
    "build": "node ../scripts/sync-exercise-sprite-catalogue.mjs --check && vite build && node scripts/inject-sw-manifest.mjs",
    "build:vercel": "node ../scripts/sync-exercise-sprite-catalogue.mjs --check && vite build --mode=vercel && node scripts/inject-sw-manifest.mjs",
    "build:mobile": "node ../scripts/sync-exercise-sprite-catalogue.mjs --check && vite build --mode=mobile && cap sync",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fatigue-probe": "node scripts/fatigue-monotonic-probe.mjs",
    "check:i18n": "node scripts/check-locales.mjs && node scripts/check-source-strings.mjs --strict && node scripts/check-pt-br.mjs",
    "build:mobile:web": "node ../scripts/sync-exercise-sprite-catalogue.mjs --check && vite build --mode=mobile",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:pwa": "vite build --mode=pwa-test && node scripts/inject-sw-manifest.mjs && playwright test --config=playwright.pwa.config.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "7.6.9",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@supabase/supabase-js": "^2.116.0",
    "framer-motion": "^12.43.0",
    "html-to-image": "^1.11.13",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/cli": "7.6.9",
    "@capacitor/ios": "7.6.9",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.0.3",
    "happy-dom": "^21.0.4",
    "linkedom": "^0.18.13",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "workbox-build": "^7.4.1"
  }
}
