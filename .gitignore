# Optional local exercise media
media/img/
media/gif/

# Runtime data — users, passkeys, per-user state, session secret
data/

# Local config and deployment metadata
.env
.env.*
.env.*.local
!.env.example
!frontend/.env.development
!frontend/.env.mobile
!frontend/.env.vercel
.vercel/

# Local Supabase state and credentials; keep supabase/config.toml and migrations tracked.
.supabase/
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/.env.*
supabase/*secret*

# Signing keys and certificates must never enter source control
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
frontend/android/key.properties

# Build output / deps
frontend/dist/
frontend/icons/
node_modules/
*.log
.DS_Store
.superpowers/sdd/
.worktrees/
