  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "setup": "npm ci --prefix frontend",
    "dev": "npm --prefix frontend run dev",
    "test": "npm --prefix frontend test",
    "check:supabase": "node --test scripts/check-supabase-boundaries.test.mjs scripts/check-account-snapshot-migration.test.mjs scripts/check-professional-profile-migration.test.mjs scripts/check-professional-onboarding-migration.test.mjs && node scripts/check-supabase-boundaries.mjs",
