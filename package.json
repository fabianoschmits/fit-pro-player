{
  "name": "fit-pro-player",
  "version": "1.2.9",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "setup": "npm ci --prefix frontend",
    "dev": "npm --prefix frontend run dev",
    "test": "npm --prefix frontend test",
    "check:supabase": "node --test scripts/check-supabase-boundaries.test.mjs scripts/check-account-snapshot-migration.test.mjs scripts/check-professional-profile-migration.test.mjs scripts/check-professional-onboarding-migration.test.mjs scripts/check-account-lifecycle-migration.test.mjs scripts/check-professional-workflow-migration.test.mjs scripts/check-assigned-program-migration.test.mjs scripts/check-professional-management-migration.test.mjs scripts/check-professional-invite-revocation-migration.test.mjs scripts/check-professional-readiness-migration.test.mjs scripts/check-notification-migration.test.mjs scripts/check-student-professional-management-migration.test.mjs scripts/check-ops-console-migration.test.mjs && node scripts/check-supabase-boundaries.mjs",
    "test:notifications": "node --test supabase/functions/push-dispatch/*.test.mjs",
    "build": "npm --prefix frontend run build",
    "build:vercel": "npm --prefix frontend run build:vercel",
    "audit": "npm audit --prefix frontend --audit-level=high",
    "check:database": "node scripts/run-database-tests.mjs",
    "test:e2e": "npm --prefix frontend run test:e2e"
  },
  "devDependencies": {
    "web-push": "^3.6.7"
  }
}
