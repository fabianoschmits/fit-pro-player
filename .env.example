# Copy these public values to frontend/.env.local for local development.
# They are intentionally Vite-prefixed because they are safe to ship to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PRIVACY_CONTROLLER_NAME=PREENCHER_NOME_LEGAL_DO_CONTROLADOR
VITE_PRIVACY_DPO_EMAIL=PREENCHER_CANAL_LGPD
VITE_PRIVACY_CONTROLLER_ADDRESS=PREENCHER_ENDERECO_DO_CONTROLADOR
VITE_PRIVACY_RETENTION_SUMMARY=PREENCHER_POLITICA_DE_RETENCAO
VITE_PRIVACY_OPERATORS=PREENCHER_OPERADORES_E_SUBOPERADORES
VITE_PRIVACY_TRANSFER_SUMMARY=PREENCHER_TRANSFERENCIAS_INTERNACIONAIS
