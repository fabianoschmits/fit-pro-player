{
  "name": "fit-pro-player-three-minute",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test ../timing.test.mjs",
    "build": "node ../build.mjs",
    "check": "hyperframes check --samples 31 --snapshots",
